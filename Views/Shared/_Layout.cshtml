<!-- 
 Paylaşılan, tekrar eden, ortak kullanılacak olan kısımların dahil edildiği kısım layout dosyasıdır.
 RenderBody metodu ile dinamik olarak değiştirilip güncellenecek olan veri/alan temsil edilir.
-->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  @* buradaki tilda işaretinin sonrasına eklenen / işareti direkt olarak wwwroot klasörünün içerisini temsil etmektedir. *@
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
  <title>Document</title>
</head>

<body>
  <header>
    <!-- Partial view kullanım örneği. parametre olarak dosya adı uzantısız şekilde verilir.  -->
    @await Html.PartialAsync("_Navbar")
  </header>

  <main class="container my-3">
    @RenderBody()

  </main>

</body>

</html>