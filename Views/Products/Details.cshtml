@model Product

<div class="row">
  <div class="col-4">
    <img src="~/img/@Model.Photo" alt="@Model.Title" class="img-fluid">
  </div>
  <div class="col-8">
    <h2>@Model.Title</h2>
    <p>@Model.Description</p>
    <p>@Model.Price</p>
    @if(@Model.IsSale)
    {
      <p>Satışta</p>
    }
    else {
      <p>Satışta değil</p>
    }
    
  </div>
</div>
