@model Course

<div class="col">
  <div class="card">
    @* Statik dosya kullanım örneği. yine tilda işareti ile ilgili dizin yazılır ve dosyaya ulaşılır. *@
    <img src="~/img/@Model.Image" class="card-img-top" alt="" srcset="">
    <div class="card-body">
      <h5 class="card-title">@Model.Title</h5>
      <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, nesciunt!</p>
      <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.Id" class="card-link">İncele</a>
    </div>
  </div>
</div>