@model List<Course>


<div class="d-flex justify-content-between align-items-center">
<h1 class="mb-4">Kurslar</h1>
<a asp-controller="Course" asp-action="List" class="btn btn-outline-warning">Tüm Kurslar</a>
</div>


<div class="row kurslar">
  @* 
  - Bu metoda parametre olarak bu şekilde dosya adı verilebildiği gibi ~(option + N ile yapılır), 
  - ~Views/Home/_CourseCard.cshtml şeklinde de parametre geçilebilir.
  - ~ işareti kök dizini temsil eder. *@

  @foreach (Course course in @Model)
  {
    @if (@course.IsHome)
    {
      <div class="col-md-4">
        @await Html.PartialAsync("_CourseCard", course)
      </div>
    }
  }
  

</div>